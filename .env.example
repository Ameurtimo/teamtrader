# Copie ce fichier en .env (ou exporte la variable dans ton terminal)
ANTHROPIC_API_KEY=sk-ant-...
# Optionnel : modèle utilisé par tous les agents
TEAMTRADER_MODEL=claude-opus-5-5
# Optionnel : prix spot XAU/USD et BTC/USD (clé gratuite sur twelvedata.com)
TWELVEDATA_API_KEY=
# Optionnel : protège l'interface web par un mot de passe
TEAMTRADER_PASSWORD=
